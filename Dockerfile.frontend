# Use an official Python runtime as a parent image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install git for cloning the repository
RUN apt-get update && \
    apt-get install -y git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Clone the repository
RUN git clone https://github.com/gin-g/whookan.git

# Set the working directory to the frontend directory
WORKDIR /app/whookan/whokan

# Install dependencies (using the same requirements.txt)
RUN pip install --no-cache-dir -r requirements.txt

# Set the working directory to the frontend directory
WORKDIR /app/whookan/whokan/frontend

# Expose the port that the app runs on
EXPOSE 8080

# Command to run the application
CMD ["python", "-m", "http.server", "8080", "--bind", "0.0.0.0"]